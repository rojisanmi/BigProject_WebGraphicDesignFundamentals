# Briking Nyus - Environment Variables
# Copy this file to .env.local and fill in your values

# App
VITE_APP_NAME=Briking Nyus
VITE_APP_URL=https://brikingnyus.com
VITE_API_URL=/api

# News APIs (Get free keys from respective websites)
# NewsAPI.org - https://newsapi.org/register (100 req/day free)
VITE_NEWS_API_KEY=your_newsapi_key_here

# GNews - https://gnews.io/register (100 req/day free)
VITE_GNEWS_API_KEY=your_gnews_key_here

# NewsData.io - https://newsdata.io/register (200 req/day free)
VITE_NEWSDATA_API_KEY=your_newsdata_key_here

# Database (for production backend)
# DATABASE_URL=postgresql://user:pass@localhost:5432/briking_nyus

# Analytics
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_PLAUSIBLE_DOMAIN=brikingnyus.com

# reCAPTCHA for forms
# VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key (server only)

# Email service (for contact form)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@brikingnyus.com
# SMTP_PASS=your_smtp_password
# CONTACT_EMAIL=redaksi@brikingnyus.com

# Redis (for caching)
# REDIS_URL=redis://localhost:6379

# Sentry (error tracking)
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# Feature flags
VITE_ENABLE_PWA=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_BOOKMARKS=true
VITE_ENABLE_COMMENTS=false